DATABASE_URL="postgresql://opsninja:opsninja@localhost:5432/opsninja?schema=public"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"
COOKIE_NAME="opsninja.sid"
NODE_ENV="development"
PORT="4000"
FRONTEND_ORIGIN="http://localhost:5173" # In production: e.g. "https://opsninja.vercel.app"
# For cross-origin production (e.g. Render backend + Vercel frontend), set COOKIE_SECURE="true" and COOKIE_SAMESITE="none"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# SimuAI AI Operations Assistant (Groq) - Backend only secrets
AI_PROVIDER="groq" # Options: "groq" (hosted LLM) | "gemini" | "mock" (offline engine) | "none"
AI_MODEL="openai/gpt-oss-20b" # Default: openai/gpt-oss-20b
GROQ_API_KEY="your_groq_api_key_here" # Generate free key at https://console.groq.com/keys
AI_API_KEY="" # Optional: for Gemini if AI_PROVIDER="gemini"

LOG_LEVEL="info"

# Transactional Email (EmailJS REST API) - Backend only secret
EMAILJS_SERVICE_ID="your_service_id"
EMAILJS_TEMPLATE_ID="your_template_id"
EMAILJS_PUBLIC_KEY="your_public_key"
EMAILJS_PRIVATE_KEY="your_private_key"

# Cloudflare Turnstile Bot Protection - Backend only secret
TURNSTILE_SECRET_KEY=""
