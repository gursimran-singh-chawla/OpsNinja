generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  lead
  manager
  associate
}

enum TaskCategory {
  normal
  escalation
  inventory
  vendor
  customer
  other
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum WorkKind {
  task
  escalation
  backlog
  report
}

enum VisibilityType {
  GLOBAL
  TEAM
  DIRECT
}

enum BoardColumn {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum AccessType {
  VIEW
  ASSIGNEE
}

enum ConversationType {
  GLOBAL
  DM
}

enum NotificationType {
  mention
  task_assigned
  task_shared
  task_routed_to_manager
  task_overdue
  task_updated
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  name                       String
  passwordHash               String
  role                       Role
  reportsToId                String?
  reportsTo                 User?     @relation("ReportsTo", fields: [reportsToId], references: [id])
  reports                   User[]    @relation("ReportsTo")
  deactivatedAt              DateTime?
  emailVerifiedAt            DateTime?
  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationAttempts  Int       @default(0)
  emailVerificationSentAt    DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sessions                  Session[]
  createdTasks              Task[]                    @relation("TaskCreator")
  assignedTasks             Task[]                    @relation("TaskAssignee")
  assignedByTasks           Task[]                    @relation("TaskAssignedBy")
  visibilityManagerTasks    Task[]                    @relation("TaskVisibilityManager")
  taskAccessGrants          TaskAccess[]              @relation("AccessUser")
  taskAccessGranted         TaskAccess[]              @relation("AccessGrantedBy")
  comments                  Comment[]
  mentions                  Mention[]                 @relation("MentionedUser")
  notifications             Notification[]
  auditEvents               AuditEvent[]
  conversationsCreated      Conversation[]
  participants              ConversationParticipant[]
  messages                  Message[]

  @@index([reportsToId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id                  String         @id @default(uuid())
  title               String
  description         String
  category             TaskCategory
  workKind            WorkKind       @default(task)
  metadata            Json?
  priority            TaskPriority   @default(normal)
  dueAt               DateTime?
  createdById         String
  createdBy           User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  visibilityType      VisibilityType
  visibilityManagerId String?
  visibilityManager   User?          @relation("TaskVisibilityManager", fields: [visibilityManagerId], references: [id], onDelete: Restrict)
  assigneeId          String?
  assignee            User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById        String?
  assignedBy          User?          @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  sourceMessageId     String?
  redFlag             Boolean        @default(false)
  boardColumn         BoardColumn    @default(TODO)
  boardRank           String         @default("000000500000")
  finishedAt          DateTime?
  archivedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  access   TaskAccess[]
  comments Comment[]

  @@index([assigneeId])
  @@index([createdById])
  @@index([visibilityType])
  @@index([visibilityManagerId])
  @@index([workKind])
  @@index([priority])
  @@index([dueAt])
  @@index([archivedAt])
  @@index([boardColumn, boardRank])
}

model TaskAccess {
  id          String     @id @default(uuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation("AccessUser", fields: [userId], references: [id], onDelete: Restrict)
  accessType  AccessType @default(VIEW)
  grantedById String
  grantedBy   User       @relation("AccessGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime  @default(now())
  mentions  Mention[]

  @@index([taskId, createdAt])
}

model Mention {
  id              String   @id @default(uuid())
  commentId       String?
  comment         Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  messageId       String?
  message         Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  @@index([mentionedUserId])
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
}

model ConversationParticipant {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  joinedAt          DateTime     @default(now())
  lastReadMessageId String?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  mentions       Mention[]

  @@index([conversationId, createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  taskId      String?
  messageId   String?
  actorId     String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
